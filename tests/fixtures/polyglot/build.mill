//| mill-version: 1.3.1
//| mvnDeps: ["com.lihaoyi::mill-contrib-buildinfo:$MILL_VERSION"]
package build
import mill.*, mill.javalib.*, mill.javalib.publish.*
import mill.kotlinlib.KotlinModule
import mill.scalalib.ScalaModule
import mill.contrib.buildinfo.BuildInfo
import mill.util.VcsVersionModule

// No mill-jvm-version: Mill runs its daemon on the JVM it downloads by
// default.

trait Published extends PublishModule {
  def pomSettings = PomSettings(
    description = "polyglot",
    organization = "example",
    url = "https://example.com",
    licenses = Seq(License.MIT),
    versionControl = VersionControl.github("example", "polyglot"),
    developers = Seq()
  )
}

// Java, on a JVM of its own, with a dependency from Maven Central and one
// from a custom repository.
object greeter extends JavaModule, Published {
  def publishVersion = "0.1.0"
  def jvmId = "zulu:17"
  def repositories = Seq("https://maven.google.com")
  def mvnDeps = Seq(
    mvn"com.google.guava:guava:33.4.8-jre",
    mvn"androidx.annotation:annotation-jvm:1.9.1"
  )
}

// Kotlin, on top of the Java module.
object hello extends KotlinModule, Published {
  def kotlinVersion = "2.1.20"
  def publishVersion = "0.1.0"
  def moduleDeps = Seq(greeter)
}

// Scala, with a meta-build plugin (BuildInfo) and its version from git.
object versioned extends ScalaModule, BuildInfo, Published, VcsVersionModule {
  def scalaVersion = "3.7.3"
  def buildInfoPackageName = "versioned"
  def buildInfoMembers = Seq(BuildInfo.Value("scalaVersion", scalaVersion()))
}
